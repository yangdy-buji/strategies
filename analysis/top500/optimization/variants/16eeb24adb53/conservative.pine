//@version=2
// 优化候选 conservative-v1 · 2026-10-24
// 原文件：混沌交易规则止损策略Chaotic-Trading-Rules-Stop-Loss-Strategy.md
// 原文件SHA256：2f97ce4968d899939a8c0441cbab1b7f2b35b0ae15e50bdfcceb9b307d5fc8e1
// SID：4868；原研究名单序号：445
// 状态：未原生编译，未回测。原排名和旧绩效不适用于本版本。
// 范围：只修复下方OPT备注列出的缺陷；剩余问题见changes.md。
// 原backtest区块为原始资料配置，不代表本版本完成过回测。

/*backtest
start: 2022-11-06 00:00:00
end: 2023-11-06 00:00:00
period: 1d
basePeriod: 1h
exchanges: [{"eid":"Futures_Binance","currency":"BTC_USDT"}]
*/
strategy("Adding some essential components to a prebuilt RSI strategy", overlay=true)

/////////////// Component Code Start ///////////////
testStartYear = input(2011, "Backtest Start Year") 
testStartMonth = input(8, "Backtest Start Month")
testStartDay = input(1, "Backtest Start Day")
testPeriodStart = timestamp(testStartYear,testStartMonth,testStartDay,0,0)

testStopYear = input(2016, "Backtest Stop Year")
testStopMonth = input(9, "Backtest Stop Month")
testStopDay = input(29, "Backtest Stop Day")
// testStopDay = testStartDay + 1
testPeriodStop = timestamp(testStopYear,testStopMonth,testStopDay,0,0)

// A switch to control background coloring of the test period
testPeriodBackground = input(title="Color Background?", type=bool, defval=true)
testPeriodBackgroundColor = testPeriodBackground and (time >= testPeriodStart) and (time <= testPeriodStop) ? #00FF00 : na
bgcolor(testPeriodBackgroundColor, transp=97)

// OPT-4868-01：日期函数恒真。
// OPT-4868-01 保持：原参数、仓位及窗外退出
// OPT-4868-01 验证：未原生Pine编译/回测；静态/表达式用例不证明收益。
testPeriod() => time >= testPeriodStart and time <= testPeriodStop
/////////////// Component Code Stop ///////////////

///////////// RSI component /////////////
length = input( 14 )
overSold = input( 30 )
overBought = input( 70 )
price = close

vrsi = rsi(price, length)
notna = not na(vrsi)

/////////////// STRATEGY ///////////////
ts = input(99999, "Trailing Stop") / 100
tp = input(99999, "Take Profit") / 100
sl = input(99999, "Stop Loss") / 100

long = notna and crossover(vrsi, overSold)
short = notna and crossunder(vrsi, overBought)

last_long = long ? time : nz(last_long[1])
last_short = short ? time : nz(last_short[1])

long_signal = crossover(last_long, last_short)
short_signal = crossover(last_short, last_long)

// OPT-4868-05：价格和方向时间锚点仅在允许入场的窗口信号更新，避免窗外无新仓却重写存量仓位保护基准。
// OPT-4868-05 保持：原信号、数量、价格参数与Pine版本保持。
// OPT-4868-05 验证：未原生Pine编译/回测；静态/表达式用例不证明收益。
last_open_long_signal = (testPeriod() and long_signal) ? open : nz(last_open_long_signal[1])
// OPT-4868-06：价格和方向时间锚点仅在允许入场的窗口信号更新，避免窗外无新仓却重写存量仓位保护基准。
// OPT-4868-06 保持：原信号、数量、价格参数与Pine版本保持。
// OPT-4868-06 验证：未原生Pine编译/回测；静态/表达式用例不证明收益。
last_open_short_signal = (testPeriod() and short_signal) ? open : nz(last_open_short_signal[1])

// OPT-4868-07：价格和方向时间锚点仅在允许入场的窗口信号更新，避免窗外无新仓却重写存量仓位保护基准。
// OPT-4868-07 保持：原信号、数量、价格参数与Pine版本保持。
// OPT-4868-07 验证：未原生Pine编译/回测；静态/表达式用例不证明收益。
last_long_signal = (testPeriod() and long_signal) ? time : nz(last_long_signal[1])
// OPT-4868-08：价格和方向时间锚点仅在允许入场的窗口信号更新，避免窗外无新仓却重写存量仓位保护基准。
// OPT-4868-08 保持：原信号、数量、价格参数与Pine版本保持。
// OPT-4868-08 验证：未原生Pine编译/回测；静态/表达式用例不证明收益。
last_short_signal = (testPeriod() and short_signal) ? time : nz(last_short_signal[1])

in_long_signal = last_long_signal > last_short_signal
in_short_signal = last_short_signal > last_long_signal

last_high = not in_long_signal ? na : in_long_signal and (na(last_high[1]) or high > nz(last_high[1])) ? high : nz(last_high[1])
last_low = not in_short_signal ? na : in_short_signal and (na(last_low[1]) or low < nz(last_low[1])) ? low : nz(last_low[1])

long_ts = not na(last_high) and high <= (last_high - ts) //and high >= last_open_long_signal
short_ts = not na(last_low) and low >= (last_low + ts) //and low <= last_open_short_signal

long_tp = high >= (last_open_long_signal + tp)
short_tp = low <= (last_open_short_signal - tp)

long_sl = low <= (last_open_long_signal - sl)
short_sl = high >= (last_open_short_signal + sl)

leverage = input(200, "Leverage")
long_call = last_open_long_signal - (0.8 + 0.2 * (1/leverage)) / leverage * last_open_long_signal
short_call = last_open_short_signal + (0.78 + 0.2 * (1/leverage)) / leverage * last_open_short_signal
long_call_signal = low <= long_call
short_call_signal = high >= short_call

// OPT-4868-02：恢复窗口时退出需继续处理已有持仓。
// OPT-4868-02 保持：原参数、仓位及窗外退出
// OPT-4868-02 验证：未原生Pine编译/回测；静态/表达式用例不证明收益。
if testPeriod() or strategy.position_size != 0
    // OPT-4868-03：窗口外不得反手入场。
    // OPT-4868-03 保持：原参数、仓位及窗外退出
    // OPT-4868-03 验证：未原生Pine编译/回测；静态/表达式用例不证明收益。
    strategy.entry("Long", strategy.long, when=testPeriod() and long_signal)
    // OPT-4868-04：窗口外不得反手入场。
    // OPT-4868-04 保持：原参数、仓位及窗外退出
    // OPT-4868-04 验证：未原生Pine编译/回测；静态/表达式用例不证明收益。
    strategy.entry("Short", strategy.short, when=testPeriod() and short_signal)

    // plot(long_call, color=red)
    // plot(short_call, color=green)
    strategy.close("Long", when=long_call_signal)
    strategy.close("Short", when=short_call_signal)
    strategy.close("Long", when=long_tp)
    strategy.close("Short", when=short_tp)
    strategy.close("Long", when=long_sl)
    strategy.close("Short", when=short_sl)
    strategy.close("Long", when=long_ts)
    strategy.close("Short", when=short_ts)
