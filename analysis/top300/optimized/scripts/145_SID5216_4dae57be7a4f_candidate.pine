// OPT-T300 SID 5216：本轮新候选·未回测
// 原文件SHA256：51d70f79bc3de103d731463b331ea167f04651fb815e2a564386de4a75f4951e
// 未原生Pine编译、未回测；旧排名与收益不适用于本候选。
/*backtest
start: 2019-12-23 08:00:00
end: 2024-12-18 08:00:00
period: 1d
basePeriod: 1d
exchanges: [{"eid":"Futures_Binance","currency":"BTC_USDT"}]
*/

//@version=5
strategy("Adaptive VWAP Bands with Garman Klass Volatility", overlay=true)

// Inputs
// OPT-T300-01 修改原因：限制周期至少1，拒绝零/负窗口。
// OPT-T300-01 保持行为：保留有效数据下原参数、信号、数量公式及Pine版本；不引入中性值或沿用旧值伪造可交易数据。
length = input.int(25, title="Volatility Length", minval=1)
// OPT-T300-02 修改原因：限制周期至少1，拒绝零/负窗口。
// OPT-T300-02 保持行为：保留有效数据下原参数、信号、数量公式及Pine版本；不引入中性值或沿用旧值伪造可交易数据。
vwapLength = input.int(14, title="VWAP Length", minval=1)
vol_multiplier = input.float(1,title="Volatility Multiplier")

// Function to calculate Garman-Klass Volatility
var float sum_gkv = na
if na(sum_gkv)
    sum_gkv := 0.0

sum_gkv := 0.0
for i = 0 to length - 1
    // OPT-T300-04 修改原因：对数价格比必须有正价格，缺失或非正价格窗口显式保持NA。
    // OPT-T300-04 保持行为：有效值原公式不变；所有历史函数逐柱预计算，guard仅作用于标量，暖机/无定义值不填中性。
    validPrices = not na(high[i]) and not na(low[i]) and not na(close[i]) and not na(open[i]) and high[i] > 0 and low[i] > 0 and close[i] > 0 and open[i] > 0
    sum_gkv := validPrices ? sum_gkv + 0.5 * math.pow(math.log(high[i]/low[i]), 2) - (2*math.log(2)-1) * math.pow(math.log(close[i]/open[i]), 2) : na

gcv = math.sqrt(sum_gkv / length)

// VWAP calculation
vwap = ta.vwma(close, vwapLength)

// Standard deviation for VWAP bands
vwapStdDev = ta.stdev(close, vwapLength)

// Adaptive multiplier based on GCV
// OPT-T300-03 修改原因：零平均波动与暖机显式NA；暖机或零分母返回NA，不填中性0/50也不延续旧信号；取舍是恢复后穿越可能须等待下一对有效柱，避免凭空触发订单。
// OPT-T300-03 保持行为：保留有效数据下原参数、信号、数量公式及Pine版本；不引入中性值或沿用旧值伪造可交易数据。
gcvMean = ta.sma(gcv, length)
multiplier = not na(gcvMean) and gcvMean > 0 ? (gcv / gcvMean) * vol_multiplier : na

// Upper and lower bands
upperBand = vwap + (vwapStdDev * multiplier)
lowerBand = vwap - (vwapStdDev * multiplier)

// Plotting VWAP and bands
plot(vwap, title="VWAP", color=color.blue, linewidth=2)
plot(upperBand, title="Upper Band", color=color.green, linewidth=1)
plot(lowerBand, title="Lower Band", color=color.red, linewidth=1)

var barColor = color.black

// Strategy: Enter long above upper band, go to cash below lower band
if (close > upperBand)
    barColor := color.green
    strategy.entry("Long", strategy.long)
else if (close < lowerBand)
    barColor := color.fuchsia
    strategy.close("Long")

barcolor(barColor)
