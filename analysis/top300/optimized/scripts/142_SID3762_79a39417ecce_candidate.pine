// OPT-T300 SID 3762：本轮新候选·未回测
// 原文件SHA256：e1aab7e69324f8fc14e28909a498e4a764ada05bb1ed0476479e2f5d2060dc24
// 未原生Pine编译、未回测；旧排名与收益不适用于本候选。
// 优化候选 conservative-v1 · 2026-10-24
// 原文件：多周期RSI超卖反转策略-Multi-Timeframe-RSI-Oversold-Reversal-Strategy.md
// 原文件SHA256：e1aab7e69324f8fc14e28909a498e4a764ada05bb1ed0476479e2f5d2060dc24
// SID：3762；原研究名单序号：14
// 状态：未原生编译，未回测。原排名和旧绩效不适用于本版本。
// 范围：只修复下方OPT备注列出的缺陷；剩余问题见changes.md。
// 原backtest区块为原始资料配置，不代表本版本完成过回测。

/*backtest
start: 2024-08-26 00:00:00
end: 2024-09-24 08:00:00
period: 1h
basePeriod: 1h
exchanges: [{"eid":"Futures_Binance","currency":"BTC_USDT"}]
*/
strategy(" 15min oversold gold", overlay=true)

// Parameters
rsiPeriod = input.int(11, title="RSI Period")
rsiSource = close
rsiEntryValue = input.float(20, title="RSI Value for Entry", step=0.1)
rsiExitValue = input.float(79, title="RSI Value for Exit", step=0.1)
emaPeriod = input.int(290, title="EMA Period")
stopLossPercent = input.float(1.4, title="Stop Loss (%)") / 100 // Convert percentage to a decimal.
takeProfitPercent = input.float(3.5, title="Take Profit (%)") / 100 // Convert percentage to a decimal.

// Calculate RSI and EMA
rsiValue = ta.rsi(rsiSource, rsiPeriod)
longEma = ta.ema(rsiSource, emaPeriod)

// Plot the EMA
plot(longEma, title="EMA", color=color.blue, linewidth=1)

// Entry conditions for long trades
longCondition = rsiValue < rsiEntryValue 

// Exit conditions for long trades
rsiExitCondition = rsiValue > rsiExitValue

// Tracking the entry price, setting stop loss, and take profit
var float entryPrice = na
// OPT-T300-01 修改原因：只在空仓信号锚定保护，持续超卖不覆盖已有入场锚。
// OPT-T300-01 保持行为：保留原信号阈值、交易方向、数量配置与Pine版本；不按旧收益调参。
if (longCondition and strategy.position_size == 0)
    entryPrice := close
stopLossPrice = entryPrice * (1 - stopLossPercent)
takeProfitPrice = entryPrice * (1 + takeProfitPercent)
stopLossHit = close < stopLossPrice
takeProfitHit = close > takeProfitPrice

// Execute trades using the if statement
if (longCondition)
    strategy.entry("Long", strategy.long)

// Distinct exit conditions
if (rsiExitCondition)
    // OPT-3762-01：RSI退出覆盖已有额外入场ID，不改变加仓配置。
    // OPT-3762-01 保持：保留默认参数、入场信号、仓位方向和数量；只修订单匹配、作用域或明确边界。
    // OPT-3762-01 验证：未原生Pine编译/回测；静态/表达式用例不证明收益。
    strategy.close("Long", comment="RSI Exit")
    strategy.close("add more", comment="RSI Exit")

if (takeProfitHit)
    // OPT-3762-02：接入已有收盘止损布尔，并让止盈/止损覆盖两个入场ID。
    // OPT-3762-02 保持：保留默认参数、入场信号、仓位方向和数量；只修订单匹配、作用域或明确边界。
    // OPT-3762-02 验证：未原生Pine编译/回测；静态/表达式用例不证明收益。
    strategy.close("Long", comment="Take Profit Hit")
    strategy.close("add more", comment="Take Profit Hit")

if (stopLossHit)
    strategy.close("Long", comment="Stop Loss Hit")
    strategy.close("add more", comment="Stop Loss Hit")


///add a more limit buy
morebuy=entryPrice*(0.98)
buymore=close<morebuy
// OPT-T300-02 修改原因：额外买入仅限真实持仓且无退出信号，旧锚不在平仓后触发新买入。
// OPT-T300-02 保持行为：保留原信号阈值、交易方向、数量配置与Pine版本；不按旧收益调参。
if buymore and strategy.position_size > 0 and not (rsiExitCondition or takeProfitHit or stopLossHit)
    strategy.entry('add more', strategy.long, qty = 3, comment = 'letgo bitch')
