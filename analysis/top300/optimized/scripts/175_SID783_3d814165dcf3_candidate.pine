// OPT-T300 SID 783：本轮新候选·未回测
// 原文件SHA256：95abb3fcc6296fff13859e123cf8d2fc6273805f13e39c1f4a93305e1cbc9feb
// 未原生Pine编译、未回测；旧排名与收益不适用于本候选。
/*backtest
start: 2023-04-06 00:00:00
end: 2024-04-11 00:00:00
period: 1d
basePeriod: 1h
exchanges: [{"eid":"Futures_Binance","currency":"BTC_USDT"}]
*/

//@version=5
strategy("RSI Strategy", overlay=true)

// Définition des paramètres
rsi_length = input(14, title="RSI Length")
buy_level = input(35, title="Buy Level")
sell_level = input(75, title="Sell Level")
// OPT-T300-02 修改原因：移除不接入声明的误导加仓输入。
// OPT-T300-02 保持行为：保留原信号阈值、交易方向、数量配置与Pine版本；不按旧收益调参。
// Enabling pyramiding and its risk budget requires a separate design experiment.

// Calcul du RSI
rsi = ta.rsi(close, rsi_length)

// Règles d'entrée
buy_signal = ta.crossover(rsi, buy_level)
sell_signal = ta.crossunder(rsi, sell_level)

// Gestion des positions
if (buy_signal)
    strategy.entry("Buy", strategy.long)
if (sell_signal)
    strategy.entry("Sell", strategy.short)

// OPT-T300-01 修改原因：删除每柱无条件多单/反向覆盖，保留RSI双向信号和默认不加仓。
// OPT-T300-01 保持行为：保留原信号阈值、交易方向、数量配置与Pine版本；不按旧收益调参。
// Pyramiding remains disabled in strategy(); entries require RSI signals.

// Tracé du RSI
plot(rsi, title="RSI", color=color.blue)
hline(buy_level, "Buy Level", color=color.green)
hline(sell_level, "Sell Level", color=color.red)

