// 未原生Pine编译、未回测；旧排名与收益不适用于本候选。
/*backtest
start: 2023-01-01 00:00:00
end: 2023-12-07 00:00:00
period: 1d
basePeriod: 1h
exchanges: [{"eid":"Futures_Binance","currency":"BTC_USDT"}]
*/

//@version=4
////////////////////////////////////////////////////////////
//  Copyright by HPotter v1.0 05/02/2020
// Evaluates for n number of consecutive higher closes. Returns a value 
// of 1 when the condition is true or 0 when false.
//
// WARNING:
// - For purpose educate only
// - This script to change bars colors.
////////////////////////////////////////////////////////////
strategy(title="N Bars Up", shorttitle="NBU Backtest", overlay = false) 
nLength = input(4, minval=1)
// OPT-T300-02 修改原因：输入按实际价格差命名，保留原数值单位。
// OPT-T300-02 保持行为：保留原信号阈值、交易方向、数量配置与Pine版本；不按旧收益调参。
input_takeprofit = input(20, title="Take Profit price distance", step=0.01)
// OPT-T300-03 修改原因：输入按实际价格差命名，保留原数值单位。
// OPT-T300-03 保持行为：保留原信号阈值、交易方向、数量配置与Pine版本；不按旧收益调参。
input_stoploss = input(10, title="Stop Loss price distance", step=0.01)
nCounter = 0
nCounter := iff(close[1] >= open[1], nz(nCounter[1],0)+1,
             iff(close[1] < open[1], 0, nCounter))
C1 = iff(nCounter >= nLength, 1, 0)
posprice = 0.0
pos = 0
barcolor(nz(pos[1], 0) == -1 ? color.red: nz(pos[1], 0) == 1 ? color.green : color.blue ) 
// OPT-T300-01 修改原因：先按真实持仓和固定成交均价判断退出；连续信号不能重置保护或掩盖触价。
// OPT-T300-01 保持行为：保留原信号阈值、交易方向、数量配置与Pine版本；不按旧收益调参。
entrySignal = C1 == 1
posprice := strategy.position_size > 0 ? strategy.position_avg_price : 0
pos := strategy.position_size > 0 ? 1 : 0
if strategy.position_size > 0
    if low <= posprice - input_stoploss or high >= posprice + input_takeprofit
        strategy.close_all()
else if entrySignal
    strategy.entry("Long", strategy.long)
plot(C1, title='NBU', color=color.green)
